# API Keys
OPENAI_API_KEY=
# 如果你用的是 OpenRouter，填 OPENROUTER_API_KEY（可不填 OPENAI_API_KEY）
OPENROUTER_API_KEY=

OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# OpenAI client options
OPENAI_REQUEST_TIMEOUT_MS=600000
OPENAI_MAX_RETRIES=2
# bearer: default OpenAI SDK Authorization header; raw: send Authorization as the key itself for Nexus/Tokenhub gateways.
OPENAI_AUTH_HEADER_MODE=bearer
# chat: use chat.completions for QA; responses: use Responses API for Nexus/Tokenhub wire_api=responses.
OPENAI_WIRE_API=chat
OPENAI_QA_WIRE_API=chat
# OpenAI 直连通常不用填 OPENAI_BASE_URL；OpenRouter 用 OPENROUTER_BASE_URL
OPENAI_BASE_URL=

# Local-only Hybrid retrieval. Keep `off` in shared/production environments.
# A remote development model must be reached through a loopback SSH tunnel.
QA_HYBRID_RETRIEVAL_MODE=off
# Local Voice QA review collector. `collect` keeps lexical as the official answer
# and stores A/B review data only in the authenticated user's evaluation SQLite.
VOICE_QA_SHADOW_REVIEW_MODE=off
# Optional frozen worktree/build hash recorded with each review case.
VOICE_QA_SHADOW_REVIEW_CODE_FINGERPRINT=
HYBRID_EMBEDDING_BASE_URL=http://127.0.0.1:18080/v1
HYBRID_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
HYBRID_EMBEDDING_MODEL_VERSION=5cf2132abc99cad020ac570b19d031efec650f2b
HYBRID_EMBEDDING_DIMENSION=2560
HYBRID_EMBEDDING_QUERY_TIMEOUT_MS=3000
HYBRID_EMBEDDING_INDEX_TIMEOUT_MS=60000

# Voice QA fast-model selection is independent from Text QA. Keep the vLLM
# endpoint loopback-only (use an SSH tunnel for a remote development server);
# public URLs are rejected.
# LLM_PROVIDER=qwen-vllm
# Voice QA owns a separate model choice so Text QA keeps its configured GPT
# Provider. Qwen remains loopback-only and never triggers a sequential fallback.
VOICE_QA_LLM_PROVIDER=qwen-vllm
# Development-only continuous Voice transport. Keep both off to retain the
# established push-to-talk path.
VOICE_REALTIME_ENABLED=false
NEXT_PUBLIC_VOICE_REALTIME_ENABLED=false
# Separate loopback-only development WebSocket gateway. Keep disabled/unset so
# production and the existing HTTP/PTT paths remain unchanged.
VOICE_REALTIME_GATEWAY_ENABLED=false
# NEXT_PUBLIC_VOICE_REALTIME_GATEWAY_URL=ws://127.0.0.1:3011/api/voice/realtime/gateway
# VOICE_REALTIME_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Observation-only evidence injection. It never replaces canonical Qwen QA or
# releases Doubao text/audio to the browser.
VOICE_DOUBAO_RAG_SHADOW_MODE=off
# VLLM_BASE_URL=http://127.0.0.1:8700/v1
# VLLM_MODEL=Qwen/Qwen3.6-27B
# VLLM_API_KEY=dummy
# VLLM_ENABLE_THINKING=false
# DATE_COMPANION_SUBJECT_SUGGESTION_TIMEOUT_MS=240000
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter 常要求的可选请求头（可不填）
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
# OpenRouter STT 大音频会先用本机 ffprobe/ffmpeg 切成短 MP3 片段；建议不超过 60 秒
OPENROUTER_TRANSCRIBE_CHUNK_SECONDS=60
# Optional binary overrides. By default the app uses bundled ffmpeg-static / ffprobe-static when available.
FFMPEG_PATH=
FFPROBE_PATH=

# Provider selection
TRANSCRIPTION_PROVIDER=fixture
TRANSCRIPTION_FALLBACK_PROVIDER=fixture
EXTRACTION_PROVIDER=rule
EXTRACTION_FALLBACK_PROVIDER=rule
# Long-recording daily brief extraction. json avoids a structured-output probe before the JSON request.
EXTRACTION_RESPONSE_MODE=json
# Semantic-guided Daily Brief chunks use a bounded first pass and a separate recovery queue.
DAILY_BRIEF_CHUNK_CONCURRENCY=2
DAILY_BRIEF_CHUNK_RECOVERY_CONCURRENCY=1
DAILY_BRIEF_CHUNK_MAX_RETRIES=1
DAILY_BRIEF_CHUNK_RETRY_DELAY_MS=1000
DAILY_BRIEF_CHUNK_MAX_OUTPUT_TOKENS=3000
# Each provider attempt is limited to 45 seconds. SDK retries are disabled; the chunk scheduler owns one retry.
EXTRACTION_CHUNK_TIMEOUT_MS=45000
# Backward-compatible alias used only when DAILY_BRIEF_CHUNK_MAX_RETRIES is absent.
EXTRACTION_MAX_RETRIES=1
# The whole Daily Brief stage is capped at 10 minutes.
EXTRACTION_TOTAL_TIMEOUT_MS=600000
# 语气 / 情绪线索 / 互动分析：rule 为文本规则兜底，openai 为 LLM 结构化分析
AUDIO_INSIGHT_PROVIDER=deepseek
AUDIO_INSIGHT_FALLBACK_PROVIDER=rule
DEEPSEEK_AUDIO_INSIGHT_MODEL=deepseek-v4-flash
# Audio insight requests use one JSON call, are capped at 60 seconds, and never retry in the SDK.
AUDIO_INSIGHT_TIMEOUT_MS=60000
AUDIO_INSIGHT_MAX_RETRIES=0
AUDIO_INSIGHT_MAX_OUTPUT_TOKENS=4000
# Long transcripts are analyzed per TranscriptChunk with bounded concurrency.
AUDIO_INSIGHT_CHUNK_CONCURRENCY=3
AUDIO_INSIGHT_CHUNK_MAX_RETRIES=1
AUDIO_INSIGHT_CHUNK_RETRY_DELAY_MS=500
AUDIO_INSIGHT_CHUNK_TIMEOUT_MS=60000

# Relationship candidates are extracted per TranscriptChunk, then reduced into the existing card schema.
RELATIONSHIP_SIGNAL_PROVIDER=openai
RELATIONSHIP_SIGNAL_FALLBACK_PROVIDER=none
RELATIONSHIP_SIGNAL_CHUNK_CONCURRENCY=2
RELATIONSHIP_SIGNAL_CHUNK_RECOVERY_CONCURRENCY=1
RELATIONSHIP_SIGNAL_CHUNK_MAX_RETRIES=1
RELATIONSHIP_SIGNAL_CHUNK_RETRY_DELAY_MS=1000
RELATIONSHIP_SIGNAL_CHUNK_ATTEMPT_TIMEOUT_MS=75000
RELATIONSHIP_SIGNAL_CHUNK_TOTAL_BUDGET_MS=160000
RELATIONSHIP_SIGNAL_CHUNK_MAX_OUTPUT_TOKENS=2800

# Evidence-driven proactive insights for the current upload.
# Disabled by default: enabling this sends compact evidence excerpts to the official DeepSeek API.
PROACTIVE_INSIGHT_PROVIDER=none
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Requests are always capped at 30 seconds and SDK retries are forced to zero.
PROACTIVE_INSIGHT_TIMEOUT_MS=30000
PROACTIVE_INSIGHT_MAX_RETRIES=0
PROACTIVE_INSIGHT_MAX_OUTPUT_TOKENS=1800
PROACTIVE_INSIGHT_MAX_ITEMS=3
# Reuses the official DeepSeek credentials above. "auto" enables the gate with the proactive DeepSeek provider.
MEMORY_RELEVANCE_PROVIDER=auto
MEMORY_RELEVANCE_TIMEOUT_MS=15000
MEMORY_RELEVANCE_MAX_OUTPUT_TOKENS=1600

# Optional: ASR + speaker diarization provider from the internal interface document.
# This provider calls POST {SPEAKER_ASR_BASE_URL}/api/ai/non-realtime-asr with audio_url,
# then polls /api/ai/non-realtime-asr/query?reqid=...
# TRANSCRIPTION_PROVIDER=speaker-asr
SPEAKER_ASR_BASE_URL=http://speaker-asr.example.invalid:8300
# Public base URL of this Daily Brief deployment, reachable by the ASR service.
# Local Queue development should use `npm run worker:local`, which generates
# .env.audio-tunnel.local with the current Quick Tunnel URL. Do not persist a
# temporary trycloudflare.com address in .env.local.
SPEAKER_ASR_AUDIO_BASE_URL=https://daydiary.vision-intelligence.tech
# Legacy bearer used by standard and Date Companion ASR audio reads.
SPEAKER_ASR_AUDIO_ACCESS_TOKEN=
# Independent HMAC signing secret for Daily Reflection transcription capabilities.
# It is never sent to the ASR service and must not reuse the legacy bearer above.
DAILY_REFLECTION_AUDIO_CAPABILITY_SECRET=
# speaker: -1 no diarization, 0 auto, 2-10 fixed speaker count.
SPEAKER_ASR_SPEAKER=0
SPEAKER_ASR_LANGUAGE=cn
SPEAKER_ASR_TIMEOUT_MS=600000
SPEAKER_ASR_POLL_INTERVAL_MS=2000
# A code=0 response without non-empty transcript text remains provisional for
# this grace period before it becomes a retryable empty-transcript failure.
SPEAKER_ASR_EMPTY_RESULT_GRACE_MS=30000
# Voiceprint train/save use the same internal service by default. Set this only
# when voiceprint is deployed at a different base URL. Calls are user-triggered;
# there is no automatic training or contact binding.
VOICEPRINT_BASE_URL=
VOICEPRINT_TIMEOUT_MS=30000
VOICEPRINT_TRAIN_TIMEOUT_MS=240000
# Mutating Voiceprint calls reuse the same req_id and retry at most once, only
# for network/timeout/408/429/5xx failures. Retry-After is capped at 10 seconds.
VOICEPRINT_MAX_RETRIES=1
VOICEPRINT_RETRY_DELAY_MS=500
# Provider train/save responses are status-only; reject unexpectedly large bodies.
VOICEPRINT_RESPONSE_MAX_BYTES=65536
# Disabled by default. When enabled, ready uploads retain compact, user-scoped
# self-enrollment candidates for seven days and expose the explicit "这是我" flow.
VOICEPRINT_SELF_ENROLLMENT_ENABLED=false
# Separate Date Companion opt-in: the user selects one Ta voice group and the
# Worker saves it for later relationship-scoped preselection. Keep both flags
# off until real same-person, different-person, and low-quality acceptance passes.
DATE_COMPANION_VOICE_ENROLLMENT_ENABLED=false
DATE_COMPANION_PROVIDER_LABEL_CONTINUITY_ENABLED=false
MEMORY_OWNER_REVIEW_ENABLED=false
# Unified speaker-ASR chunk processing. Defaults: 5-minute chunks, 3 in flight,
# one retry per chunk, 1-second retry delay, and a 10-minute limit per attempt.
ASR_CHUNK_DURATION_SECONDS=300
ASR_CHUNK_CONCURRENCY=3
ASR_CHUNK_MAX_RETRIES=1
ASR_CHUNK_RETRY_DELAY_MS=1000
ASR_CHUNK_ATTEMPT_TIMEOUT_MS=600000
# After normal retries are exhausted, recursively bisect only empty-transcript
# chunks, bounded to depth 3 and children of at least 30 seconds. Every leaf
# must succeed; all other error codes and partial results remain strict failures.
ASR_CHUNK_EMPTY_TRANSCRIPT_SPLIT_ENABLED=true

# Optional validation tunnel helpers used by npm run validate:pipeline.
# CLOUDFLARED_BIN can point to a local cloudflared.exe. FRP_PUBLIC_BASE_URL is required for --tunnel frp.
CLOUDFLARED_BIN=
FRP_PUBLIC_BASE_URL=
FRP_COMMAND=

# Real provider mode should disable demo fallbacks:
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_FALLBACK_PROVIDER=none
# EXTRACTION_PROVIDER=openai
# EXTRACTION_FALLBACK_PROVIDER=none
# AUDIO_INSIGHT_PROVIDER=openai
# AUDIO_INSIGHT_FALLBACK_PROVIDER=rule

# OpenAI-compatible ASR uses a transcription-specific endpoint and credential.
# When OPENAI_BASE_URL points at a custom LLM gateway, both values below are
# required so audio and the generic gateway key are never sent to the wrong origin.
# Leave both blank only for direct api.openai.com transcription with OPENAI_API_KEY.
OPENAI_TRANSCRIBE_BASE_URL=
OPENAI_TRANSCRIBE_API_KEY=
# Optional ISO-639-1 language hint, for example zh or en.
OPENAI_TRANSCRIBE_LANGUAGE=

# Model selection
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
OPENAI_TEXT_MODEL=gpt-4.1-mini
# 可单独指定语气 / 情绪 / 互动分析模型；不填则复用 OPENAI_TEXT_MODEL
OPENAI_AUDIO_INSIGHT_MODEL=
# AI 问答会使用文本/聊天模型；OpenRouter 常用 openai/gpt-5-mini 这种 provider/model 格式
OPENAI_QA_MODEL=
OPENROUTER_QA_MODEL=openai/gpt-5-mini

# Upload constraints
MAX_UPLOAD_BYTES=314572800

# Local/server storage
# 本地开发默认使用项目目录下的 .data；线上内部验证建议挂载持久化卷并指向这个目录
APP_DATA_DIR=.data
# Production example:
# APP_DATA_DIR=/opt/daily-brief/shared/.data
# local: 用户自己的电脑本地验证；server: 内部线上 E2E 验证服务器
APP_STORAGE_MODE=local

# Durable pipeline execution. inline preserves the existing Next.js after() path and does not use Redis.
# queue requires Redis and an independently running `npm run worker`; it never falls back to inline.
# The project-managed Docker Redis listens on host port 6380; its container port remains 6379.
# Do not reuse, reconfigure, or stop an unrelated Redis service already bound to host port 6379.
REDIS_URL=redis://127.0.0.1:6380
PIPELINE_QUEUE_NAME=daily-brief-pipeline
PIPELINE_EXECUTION_MODE=inline
PIPELINE_WORKER_CONCURRENCY=1
PIPELINE_JOB_ATTEMPTS=3
PIPELINE_JOB_BACKOFF_MS=5000
# Product jobs in a processing sub-state are re-enqueued on worker startup after this age.
# Keep this above the longest normal stage gap (the 45-minute acceptance run included a ~12-minute Relationship stage).
PIPELINE_PROCESSING_STALE_MS=7200000
# Queue mode supports one Web process plus one Worker sharing the same absolute
# APP_DATA_DIR. Recovery and Redis history are explicitly bounded below.
PIPELINE_RECOVERY_INTERVAL_MS=60000
PIPELINE_FAILED_HEALTH_WINDOW_MS=3600000
PIPELINE_COMPLETED_RETENTION_AGE_SECONDS=86400
PIPELINE_COMPLETED_RETENTION_COUNT=1000
PIPELINE_FAILED_RETENTION_AGE_SECONDS=604800
PIPELINE_FAILED_RETENTION_COUNT=1000

# Date Companion -> Memory Bridge consumer. Product retention defaults on for
# accounts without an explicit opt-out; this separate operator kill switch runs
# only inside the single Pipeline Worker. Keep disabled until the v6/v11 schema
# preflight, complete APP_DATA_DIR backup, and queue storage-marker gate pass.
DATE_COMPANION_MEMORY_BRIDGE_CONSUMER_ENABLED=false
DATE_COMPANION_MEMORY_BRIDGE_POLL_INTERVAL_MS=5000
DATE_COMPANION_MEMORY_BRIDGE_BATCH_SIZE=10
DATE_COMPANION_MEMORY_BRIDGE_LEASE_MS=300000
DATE_COMPANION_MEMORY_BRIDGE_RETRY_BASE_MS=5000
DATE_COMPANION_MEMORY_BRIDGE_RETRY_MAX_MS=300000
DATE_COMPANION_MEMORY_BRIDGE_SHUTDOWN_DRAIN_TIMEOUT_MS=30000
DATE_COMPANION_MEMORY_BRIDGE_OLDEST_PENDING_HEALTH_MS=900000
DATE_COMPANION_MEMORY_BRIDGE_FAILED_COUNT_THRESHOLD=10

# Disabled by default. When enabled, only uploads explicitly marked with
# x-evaluation-retention: true are retained, so other users/uploads are unaffected.
# npm run validate:pipeline adds this per-upload marker automatically in evaluation mode.
# DELETE for a retained upload requires x-evaluation-delete-confirmed: true.
EVALUATION_MODE=false
# Disabled by default. When both flags are true, only uploads explicitly marked
# for evaluation retention may save schema-failed Provider responses under
# .data/evaluation/provider-raw-responses. Files can contain sensitive user text.
DEBUG_SAVE_PROVIDER_RESPONSE=false

# Volcengine Realtime Voice Gateway MVP. Disabled unless `npm run voice:demo` is invoked.
# Credentials come from the Volcengine console and must stay in .env.local or the process environment.
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_APP_KEY=
VOLCENGINE_RESOURCE_ID=volc.speech.dialog
# Optional adapter settings. The MVP supports the documented O2.0/SC2.0 model identifiers.
VOLCENGINE_REALTIME_MODEL=1.2.1.1
VOLCENGINE_TTS_SPEAKER=
# Keep the documented endpoint unless Volcengine explicitly provides a replacement.
VOLCENGINE_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/realtime/dialogue
VOLCENGINE_REALTIME_CONNECT_TIMEOUT_MS=15000
VOLCENGINE_REALTIME_EVENT_TIMEOUT_MS=30000

# Voice runtime/smoke selection. Production keeps test/debug mode disabled.
# `npm run voice:smoke` injects a mock transport even when the configured provider is volcengine.
VOICE_PROVIDER=volcengine
VOICE_TEST_MODE=false
VOICE_DEBUG=false
# Production remains on the existing evidence-aware Agent QA path. `direct` is
# an isolated benchmark mode that reuses the same retrieval output and safety validation.
VOICE_ANSWER_MODE=agent

# Invite-only registration
# 支持逗号或换行分隔多个邀请码；未配置时注册入口会被服务端拒绝
DAILY_BRIEF_INVITE_CODES=

# Daily Reflection is not part of the public product surface yet. Keep both
# ingestion switches off in production until a separate product release gate.
DAILY_REFLECTION_UPLOAD_ENABLED=false
DAILY_REFLECTION_BROWSER_RECORDING_ENABLED=false

# Experimental cross-module Toy Sync browser input. Disabled by default.
# This only exposes the user-authorized directory scanner; each product keeps
# its existing upload, source, participant, confirmation, and Memory gates.
DAILY_BRIEF_TOY_SYNC_ENABLED=false
# Compatibility fallback used only when DAILY_BRIEF_TOY_SYNC_ENABLED is absent:
# DAILY_REFLECTION_TOY_SYNC_ENABLED=false

# Date Companion Toy uploads stay fail-closed unless the minimal `recovery`
# mode is selected explicitly. Recovery actively uses the canonical receipt
# path; it is not an observation-only shadow. Legacy `shadow` is only an alias.
# `enforce` is intentionally rejected, and ordinary manual uploads bypass this gate.
DAILY_BRIEF_TOY_INGESTION_MODE=off

# Example internal online E2E settings:
# APP_DATA_DIR=/opt/daily-brief/shared/.data
# APP_STORAGE_MODE=server
# DAILY_BRIEF_INVITE_CODES=replace-with-one-or-more-invite-codes
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_FALLBACK_PROVIDER=none
# EXTRACTION_PROVIDER=openai
# EXTRACTION_FALLBACK_PROVIDER=none
# AUDIO_INSIGHT_PROVIDER=openai
# AUDIO_INSIGHT_FALLBACK_PROVIDER=rule
# MAX_UPLOAD_BYTES=314572800
