{
  "datasetVersion": "work-review-sample-30m-v1",
  "evaluationNote": "Freeze before the real run. Authored names are audio ground truth only, never production owner authority. Judge semantics against actual Canonical Evidence; separate ASR losses, extraction, verification, deduplication and overflow.",
  "must": [
    {
